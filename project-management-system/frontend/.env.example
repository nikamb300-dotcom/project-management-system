# Frontend environment variables
# Copy this file to `.env` and set VITE_API_URL to your backend URL.

# Local development:
VITE_API_URL=http://localhost:8000

# GitHub Codespaces (replace YOUR-CODESPACE-NAME with your actual codespace name;
# the backend port 8000 must be forwarded and set to "Public" visibility):
# VITE_API_URL=https://YOUR-CODESPACE-NAME-8000.app.github.dev

# NOTE: After changing this file you MUST restart the Vite dev server,
# because Vite only reads env vars at startup.
